# Copie este arquivo para .env.local (dev) e nunca commite chaves reais.
# Em produção (Vercel), configure as mesmas variáveis em
# Project Settings → Environment Variables.

# Chave da API da Anthropic (Claude), usada em src/services/ai/provedor.server.ts
# para leitura de comprovantes/notas fiscais por visão computacional.
# Obtenha em https://console.anthropic.com/settings/keys
# Sem esta variável, o app usa um provedor "mock" (sem IA real) para dev.
ANTHROPIC_API_KEY=

# Modelo usado na extração (opcional). Padrão: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres (Neon). DATABASE_URL é a conexão via pool (usada pelo app em
# runtime); DATABASE_URL_UNPOOLED é a conexão direta (usada pelo Prisma em
# migrations). Veja Project Settings → Environment Variables na Vercel/Neon.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
