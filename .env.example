# Copie este arquivo para .env.local (dev) e nunca commite chaves reais.
# Em produção (Vercel), configure as mesmas variáveis em
# Project Settings → Environment Variables.

# Chave da API da Anthropic (Claude), usada em src/services/ai/provedor.server.ts
# para leitura de comprovantes/notas fiscais por visão computacional.
# Obtenha em https://console.anthropic.com/settings/keys
# Sem esta variável, o app usa um provedor "mock" (sem IA real) para dev.
ANTHROPIC_API_KEY=

# Modelo usado na extração (opcional). Padrão: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres (Neon). DATABASE_URL é a conexão via pool (usada pelo app em
# runtime); DATABASE_URL_UNPOOLED é a conexão direta (usada pelo Prisma em
# migrations). Veja Project Settings → Environment Variables na Vercel/Neon.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# URL pública do site (sem barra final), usada em sitemap, canonical e dados
# estruturados dos perfis públicos da rede. Em produção, use o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de suporte e contestações exibido no site e nos e-mails. Sem ele, usa o endereço atual.
NEXT_PUBLIC_EMAIL_CONTATO=

# E-mail transacional (confirmação de e-mail) via Resend: https://resend.com/api-keys
# O domínio do remetente precisa estar verificado no Resend (SPF/DKIM).
# Sem estas variáveis: em dev o link sai no console do servidor; em produção o
# envio falha e ninguém consegue confirmar o e-mail (publicar/avaliar ficam bloqueados).
RESEND_API_KEY=
# Ex.: Elo Negócios <nao-responder@seudominio.com.br>
EMAIL_REMETENTE=

# Lembretes do calendário (e-mail + notificação no app). A rota /api/cron/lembretes só responde a quem manda
# "Authorization: Bearer <CRON_SECRET>"; sem a variável ela fica fechada (503). Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# O mesmo valor entra como segredo CRON_SECRET (e APP_URL) no GitHub: .github/workflows/lembretes.yml
CRON_SECRET=
# Opcionais (hora local, 0 a 23): lembrete de compromisso de dia inteiro (padrão 9) e lembrete "do dia" de
# compromisso com horário (padrão 8, nunca a menos de 1 h do início).
CALENDARIO_HORA_DIA_INTEIRO=
CALENDARIO_HORA_LEMBRETE_DO_DIA=

# Chave de cifra dos documentos de verificacao (Fase 6.5b): AES-256-GCM, 32 bytes em base64.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Sem ela, o envio de documentos fica indisponivel (falha fechada). Em producao use uma chave
# propria e GUARDE-A: sem a chave os documentos pendentes nao abrem (os decididos ja foram apagados).
DOCUMENTOS_CHAVE=

# Mercado Pago — cobrança de planos comerciais (mensal recorrente via assinatura + anual em pagamento único
# parcelado). Access token do app, usado em src/lib/mercadopago/cliente.server.ts. Em dev, use só credencial de
# TESTE (nunca a de produção: veja a aba Credenciais de teste do seu app no Mercado Pago). Sem esta variável, a
# página de planos só mostra o link "Falar com a equipe" (sem botão de pagamento).
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta da configuração de Webhooks do app (painel Mercado Pago > Suas integrações > aplicação >
# Webhooks), usada em src/app/api/webhooks/mercadopago/route.ts para validar o cabeçalho x-signature. Sem ela, o
# endpoint de webhook fica fechado (503) e nenhum pagamento confirma automaticamente.
MERCADOPAGO_WEBHOOK_SECRET=

# Notificações push dos lembretes do calendário (Web Push / VAPID). Gere o par UMA vez com:
#   npx web-push generate-vapid-keys
# A pública vai para o navegador (NEXT_PUBLIC_*); a privada nunca sai do servidor. Sem as duas, o botão de push
# some do Calendário e de Configurações. Trocar o par depois derruba as inscrições já feitas (todos precisam ligar de novo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
