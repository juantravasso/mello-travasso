{
  "name": "elo-negocios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "testar:calendario": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-calendario.ts",
    "testar:ciclo": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-ciclo-de-vida.ts",
    "testar:forma-pagamento": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-forma-pagamento.ts",
    "testar:convite": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-convite.ts",
    "testar:metricas": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-metricas.ts",
    "testar:planos": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-planos-comerciais.ts",
    "testar:assinaturas": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-assinatura-comercial.ts",
    "demo:semear": "node --conditions=react-server --import tsx scripts/demo/semear-demo.ts",
    "demo:dev": "node scripts/demo/comando.mjs dev",
    "demo:migrar": "node scripts/demo/comando.mjs migrar",
    "testar:onboarding": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-onboarding.ts",
    "testar:deposito": "node --conditions=react-server --import tsx --env-file=.env.local scripts/testar-deposito.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
