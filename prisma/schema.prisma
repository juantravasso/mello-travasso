// Schema do banco de dados (Postgres, via Neon/Vercel).
//
// Decisão importante: datas (dataInicio, dataVencimento, dataBaixa, etc.)
// são armazenadas como String no formato ISO "yyyy-mm-dd", não como o tipo
// nativo DateTime do Prisma. O app inteiro já trata essas datas como texto
// simples (comparação com localeCompare, formatarData, slice(0,7) para
// extrair o mês) desde que era só localStorage — usar DateTime faria o
// Prisma devolver objetos Date do JS e quebraria essa lógica em dezenas de
// lugares. Timestamps completos (criadoEm, atualizadoEm, historico[].data)
// seguem a mesma lógica e ficam como String ISO 8601.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum StatusObraDb {
  em_andamento
  concluida
  pausada
}

enum StatusContaDb {
  em_aberto
  baixada
  cancelada
}

enum TipoContaDb {
  pagar
  receber
}

enum StatusFuncionarioDb {
  ativo
  inativo
}

enum TipoMovimentoEstoqueDb {
  entrada
  saida
  ajuste
}

model Obra {
  id                String       @id @default(uuid())
  empresaId         String
  empresa           Empresa      @relation(fields: [empresaId], references: [id])
  nome              String
  cliente           String
  endereco          String?
  status            StatusObraDb
  dataInicio        String
  dataFim           String?
  orcamentoPrevisto Float?
  observacoes       String?
  criadoEm          String
  atualizadoEm      String

  contas            ContaFinanceira[]
  itensProduto      ItemProduto[]
  funcionarios      Funcionario[]
  saldosEstoque     SaldoEstoque[]
  movimentosEstoque MovimentoEstoque[]

  @@index([empresaId])
}

model ContaFinanceira {
  id                       String        @id @default(uuid())
  empresaId                String
  empresa                  Empresa       @relation(fields: [empresaId], references: [id])
  tipo                     TipoContaDb
  obraId                   String
  obra                     Obra          @relation(fields: [obraId], references: [id])
  valor                    Float
  dataLancamento           String
  dataVencimento           String
  dataBaixa                String?
  status                   StatusContaDb @default(em_aberto)
  favorecidoOuCliente      String
  fornecedorId             String?
  fornecedor               Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  descricao                String
  categoria                String?
  formaPagamento           String?
  observacao               String?
  comprovanteUrl           String        @db.Text
  origemNotaFiscal         Boolean       @default(false)
  notaFiscalId             String?
  precisaCompletarCadastro Boolean       @default(false)
  parcelamentoId           String?
  parcelaNumero            Int?
  parcelaTotal             Int?
  motivoCancelamento       String?
  /// Array de EventoHistorico ({ id, tipo, usuario, data, detalhes? }) — ver src/types/contaFinanceira.ts
  historico                Json          @default("[]")
  criadoEm                 String
  atualizadoEm             String

  itensProduto ItemProduto[]

  @@index([empresaId])
  @@index([obraId])
  @@index([tipo, status])
  @@index([fornecedorId])
}

// Cadastro de fornecedores, usado para preencher/filtrar o favorecido das
// contas a pagar (dropdown com busca + criação rápida quando a IA não
// identifica o fornecedor na leitura do comprovante).
model Fornecedor {
  id           String  @id @default(uuid())
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  nome         String
  /// CNPJ ou CPF salvo só com dígitos — chave usada para não duplicar cadastro (ver resolverFornecedor).
  documento    String?
  telefone     String?
  email        String?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  estado       String?
  observacao   String?
  criadoEm     String
  atualizadoEm String

  contas ContaFinanceira[]

  @@index([empresaId])
  @@index([nome])
  @@index([documento])
}

model ItemProduto {
  id                String          @id @default(uuid())
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  contaFinanceiraId String
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id])
  obraId            String
  obra              Obra            @relation(fields: [obraId], references: [id])
  descricao         String
  quantidade        Float
  unidade           String?
  valorUnitario     Float
  valorTotal        Float
  dataCompra        String
  fornecedor        String?
  criadoEm          String

  /// Nulo até a Fase 5.2 (integração com a captura por IA) resolver/criar o Produto do catálogo.
  produtoId         String?
  produto           Produto?           @relation(fields: [produtoId], references: [id])
  movimentosEstoque MovimentoEstoque[]

  @@index([empresaId])
  @@index([obraId])
  @@index([descricao])
}

model Funcionario {
  id           String              @id @default(uuid())
  empresaId    String
  empresa      Empresa             @relation(fields: [empresaId], references: [id])
  nome         String
  cargo        String
  telefone     String?
  email        String?
  cpf          String?
  dataAdmissao String
  obraId       String?
  obra         Obra?               @relation(fields: [obraId], references: [id])
  salario      Float?
  status       StatusFuncionarioDb @default(ativo)
  criadoEm     String
  atualizadoEm String

  @@index([empresaId])
  @@index([obraId])
}

// Categorias e formas de pagamento cadastradas pelos usuários, além das
// opções padrão (que ficam fixas em src/lib/categorias.ts).
model CategoriaPersonalizada {
  id        String      @id @default(uuid())
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  tipoConta TipoContaDb
  rotulo    String
  criadoEm  String

  @@index([empresaId])
}

model FormaPagamentoPersonalizada {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  rotulo    String
  criadoEm  String

  @@index([empresaId])
}

// --- Auth / multiempresa (ver docs/prd/multiempresa-login-trial.md) --------
// Base (login/sessão) da Fase 1; empresaId nas tabelas de dados acima, da
// Fase 2; cadastro público (tipoPessoa/endereço/plano/termos) da Fase 3;
// somente-leitura por fim de teste + EventoConta, da Fase 4.

enum PapelDb {
  dono
  membro
}

enum TipoPessoaDb {
  pj
  pf
}

enum PlanoDb {
  teste
  cortesia
  ativo
  suspenso
}

model Empresa {
  id           String @id @default(uuid())
  documento    String @unique // CNPJ ou CPF, só dígitos
  razaoSocial  String
  criadoEm     String
  atualizadoEm String

  // Fase 3 (cadastro público). tipoPessoa/plano/aceiteTermos* são obrigatórios
  // a partir daqui — backfill das empresas anteriores já rodou (ver
  // scripts/backfill-cadastro-empresa.ts). Endereço e dados de contato
  // continuam opcionais (BrasilAPI pode falhar; RF-02 permite preenchimento
  // manual parcial).
  tipoPessoa         TipoPessoaDb
  nomeFantasia       String?
  situacaoCadastral  String?
  telefone           String?
  emailContato       String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  plano              PlanoDb
  testeTerminaEm     String? // ISO datetime; null em cortesia/ativo (RF-07, RF-17)
  aceiteTermosVersao String
  aceiteTermosEm     String

  usuarios Usuario[]

  obras                         Obra[]
  contas                        ContaFinanceira[]
  fornecedores                  Fornecedor[]
  itensProduto                  ItemProduto[]
  funcionarios                  Funcionario[]
  categoriasPersonalizadas      CategoriaPersonalizada[]
  formasPagamentoPersonalizadas FormaPagamentoPersonalizada[]
  eventos                       EventoConta[]
  produtos                      Produto[]
  saldosEstoque                 SaldoEstoque[]
  movimentosEstoque             MovimentoEstoque[]
}

// Auditoria de mudanças de plano/teste (Fase 4) — hoje só extensão manual de
// teste (RF-18), via scripts/estender-teste.ts. Nunca grava e-mail, senha,
// token ou documento em claro em `detalhes` (só o necessário para a auditoria).
model EventoConta {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  tipo      String
  detalhes  Json
  criadoEm  String

  @@index([empresaId])
}

model Usuario {
  id           String  @id @default(uuid())
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  nome         String
  /// Normalizado em minúsculas antes de gravar/comparar.
  email        String  @unique
  senhaHash    String
  papel        PapelDb @default(dono)
  trocarSenha  Boolean @default(false)
  falhasLogin  Int     @default(0)
  bloqueadoAte String?
  /// Data da última falha de login (RF-10) — separado de atualizadoEm, que
  /// também muda em login OK e troca de senha e não serve como marca da janela.
  ultimaFalhaLoginEm String?
  criadoEm           String
  atualizadoEm       String

  sessoes Sessao[]

  @@index([empresaId])
}

model Sessao {
  id          String  @id // sha256(token) em hex — o token em si nunca é persistido
  usuarioId   String
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm    String
  criadoEm    String
  ultimoUsoEm String

  @@index([usuarioId])
}

// Rate limit de janela fixa (login, cadastro, IA). Chave composta em hash
// (ex.: sha256("login:" + email + ":" + ip)) — nunca e-mail/IP em claro.
model LimiteTaxa {
  chave        String @id
  janelaInicio String
  contagem     Int
}

// --- Estoque (ver docs/prd/estoque.md) -------------------------------------
// Fase 5.1: catálogo (Produto), saldo materializado por produto+obra
// (SaldoEstoque) e movimentação manual (MovimentoEstoque). `itemProdutoId`
// existe desde já porque MovimentoEstoque referencia ItemProduto, mas só é
// usado a partir da Fase 5.2 (integração com a captura por nota fiscal).

model Produto {
  id            String  @id @default(uuid())
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id])
  nome          String
  /// Único por empresa quando informado — múltiplos produtos sem SKU
  /// coexistem normalmente (Postgres não considera NULL == NULL num índice único).
  sku           String?
  categoria     String?
  unidade       String?
  /// Média ponderada pela quantidade, recalculada a cada entrada (RF-08 do PRD) — nunca em saída/ajuste.
  custoMedio    Float?
  estoqueMinimo Float?
  observacao    String?
  criadoEm      String
  atualizadoEm  String

  movimentos  MovimentoEstoque[]
  saldos      SaldoEstoque[]
  itensCompra ItemProduto[]

  @@unique([empresaId, sku])
  @@index([empresaId])
  @@index([nome])
}

// Saldo materializado por (produto, obra) — nunca somado a partir de
// MovimentoEstoque em runtime (ver mini-ADR do PRD). obraId é sempre
// obrigatório: um "estoque central" não alocado a uma obra específica usa
// uma Obra normal para representar isso, em vez de um obraId nulo (que
// quebraria a unicidade abaixo, já que Postgres trata NULL como distinto).
model SaldoEstoque {
  id           String  @id @default(uuid())
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  produtoId    String
  produto      Produto @relation(fields: [produtoId], references: [id])
  obraId       String
  obra         Obra    @relation(fields: [obraId], references: [id])
  quantidade   Float   @default(0)
  atualizadoEm String

  @@unique([produtoId, obraId])
  @@index([empresaId])
  @@index([obraId])
}

model MovimentoEstoque {
  id            String                 @id @default(uuid())
  empresaId     String
  empresa       Empresa                @relation(fields: [empresaId], references: [id])
  produtoId     String
  produto       Produto                @relation(fields: [produtoId], references: [id])
  obraId        String
  obra          Obra                   @relation(fields: [obraId], references: [id])
  tipo          TipoMovimentoEstoqueDb
  /// Sempre > 0 — o efeito no saldo (soma ou subtrai) depende de `tipo`, nunca do sinal.
  quantidade    Float
  valorUnitario Float?
  /// "manual" | "item_produto" — rastreabilidade de onde a movimentação veio.
  origem        String
  itemProdutoId String?
  itemProduto   ItemProduto?           @relation(fields: [itemProdutoId], references: [id])
  /// Nome do usuário da sessão que registrou (não FK — sobrevive se o usuário for removido no futuro), mesmo padrão de ContaFinanceira.historico[].usuario.
  lancadoPor    String
  observacao    String?
  criadoEm      String

  @@index([empresaId])
  @@index([produtoId])
  @@index([obraId])
}
