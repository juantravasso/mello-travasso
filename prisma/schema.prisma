// Schema do banco de dados (Postgres, via Neon/Vercel).
//
// Decisão importante: datas (dataInicio, dataVencimento, dataBaixa, etc.)
// são armazenadas como String no formato ISO "yyyy-mm-dd", não como o tipo
// nativo DateTime do Prisma. O app inteiro já trata essas datas como texto
// simples (comparação com localeCompare, formatarData, slice(0,7) para
// extrair o mês) desde que era só localStorage — usar DateTime faria o
// Prisma devolver objetos Date do JS e quebraria essa lógica em dezenas de
// lugares. Timestamps completos (criadoEm, atualizadoEm, historico[].data)
// seguem a mesma lógica e ficam como String ISO 8601.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum StatusObraDb {
  em_andamento
  concluida
  pausada
}

enum StatusContaDb {
  em_aberto
  baixada
  cancelada
}

enum TipoContaDb {
  pagar
  receber
}

enum StatusFuncionarioDb {
  ativo
  inativo
}

enum TipoMovimentoEstoqueDb {
  entrada
  saida
  ajuste
}

model Obra {
  id                String       @id @default(uuid())
  empresaId         String
  empresa           Empresa      @relation(fields: [empresaId], references: [id])
  nome              String
  cliente           String
  endereco          String?
  status            StatusObraDb
  dataInicio        String
  dataFim           String?
  orcamentoPrevisto Float?
  observacoes       String?
  criadoEm          String
  atualizadoEm      String
  /// O Depósito da empresa: um local de estoque (não é projeto). No máximo um por empresa (índice parcial na migração).
  ehDeposito        Boolean      @default(false)

  contas            ContaFinanceira[]
  rateios           RateioConta[]
  itensProduto      ItemProduto[]
  funcionarios      Funcionario[]
  saldosEstoque     SaldoEstoque[]
  movimentosEstoque MovimentoEstoque[]

  @@index([empresaId])
}

model ContaFinanceira {
  id                       String        @id @default(uuid())
  empresaId                String
  empresa                  Empresa       @relation(fields: [empresaId], references: [id])
  tipo                     TipoContaDb
  obraId                   String
  obra                     Obra          @relation(fields: [obraId], references: [id])
  valor                    Float
  dataLancamento           String
  dataVencimento           String
  dataBaixa                String?
  status                   StatusContaDb @default(em_aberto)
  favorecidoOuCliente      String
  fornecedorId             String?
  fornecedor               Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  descricao                String
  categoria                String?
  formaPagamento           String?
  observacao               String?
  comprovanteUrl           String        @db.Text
  origemNotaFiscal         Boolean       @default(false)
  notaFiscalId             String?
  precisaCompletarCadastro Boolean       @default(false)
  parcelamentoId           String?
  parcelaNumero            Int?
  parcelaTotal             Int?
  motivoCancelamento       String?
  /// Array de EventoHistorico ({ id, tipo, usuario, data, detalhes? }) — ver src/types/contaFinanceira.ts
  historico                Json          @default("[]")
  criadoEm                 String
  atualizadoEm             String

  itensProduto ItemProduto[]
  /// Como o valor da conta se divide entre projetos e Depósito (nota com itens em destinos diferentes). Sem rateio, vale `obraId`.
  rateios      RateioConta[]

  @@index([empresaId])
  @@index([obraId])
  @@index([tipo, status])
  @@index([fornecedorId])
}

// Cadastro de fornecedores, usado para preencher/filtrar o favorecido das
// contas a pagar (dropdown com busca + criação rápida quando a IA não
// identifica o fornecedor na leitura do comprovante).
model Fornecedor {
  id           String  @id @default(uuid())
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  nome         String
  /// CNPJ ou CPF salvo só com dígitos — chave usada para não duplicar cadastro (ver resolverFornecedor).
  documento    String?
  telefone     String?
  email        String?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  estado       String?
  observacao   String?
  criadoEm     String
  atualizadoEm String

  contas ContaFinanceira[]

  @@index([empresaId])
  @@index([nome])
  @@index([documento])
}

model ItemProduto {
  id                String          @id @default(uuid())
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  contaFinanceiraId String
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id])
  obraId            String
  obra              Obra            @relation(fields: [obraId], references: [id])
  descricao         String
  quantidade        Float
  unidade           String?
  valorUnitario     Float
  valorTotal        Float
  dataCompra        String
  fornecedor        String?
  criadoEm          String

  /// Nulo até a Fase 5.2 (integração com a captura por IA) resolver/criar o Produto do catálogo.
  produtoId         String?
  produto           Produto?           @relation(fields: [produtoId], references: [id])
  movimentosEstoque MovimentoEstoque[]

  @@index([empresaId])
  @@index([obraId])
  @@index([descricao])
}

model Funcionario {
  id           String              @id @default(uuid())
  empresaId    String
  empresa      Empresa             @relation(fields: [empresaId], references: [id])
  nome         String
  cargo        String
  telefone     String?
  email        String?
  cpf          String?
  dataAdmissao String
  obraId       String?
  obra         Obra?               @relation(fields: [obraId], references: [id])
  salario      Float?
  status       StatusFuncionarioDb @default(ativo)
  criadoEm     String
  atualizadoEm String

  @@index([empresaId])
  @@index([obraId])
}

// Categorias e formas de pagamento cadastradas pelos usuários, além das
// opções padrão (que ficam fixas em src/lib/categorias.ts).
model CategoriaPersonalizada {
  id        String      @id @default(uuid())
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  tipoConta TipoContaDb
  rotulo    String
  criadoEm  String

  @@index([empresaId])
}

model FormaPagamentoPersonalizada {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  rotulo    String
  criadoEm  String

  @@index([empresaId])
}

// --- Auth / multiempresa (ver docs/prd/multiempresa-login-trial.md) --------
// Base (login/sessão) da Fase 1; empresaId nas tabelas de dados acima, da
// Fase 2; cadastro público (tipoPessoa/endereço/plano/termos) da Fase 3;
// somente-leitura por fim de teste + EventoConta, da Fase 4.

enum PapelDb {
  dono
  membro
}

enum TipoPessoaDb {
  pj
  pf
}

enum PlanoDb {
  teste
  cortesia
  ativo
  suspenso
  /// Só a rede profissional (Fase 6): sem módulos de gestão.
  gratuito
}

enum PapelPlataformaDb {
  admin
}

model Empresa {
  id           String @id @default(uuid())
  documento    String @unique // CNPJ ou CPF, só dígitos
  razaoSocial  String
  criadoEm     String
  atualizadoEm String

  // Fase 3 (cadastro público). tipoPessoa/plano/aceiteTermos* são obrigatórios
  // a partir daqui — backfill das empresas anteriores já rodou (ver
  // scripts/backfill-cadastro-empresa.ts). Endereço e dados de contato
  // continuam opcionais (BrasilAPI pode falhar; RF-02 permite preenchimento
  // manual parcial).
  tipoPessoa         TipoPessoaDb
  nomeFantasia       String?
  situacaoCadastral  String?
  telefone           String?
  emailContato       String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  plano              PlanoDb
  testeTerminaEm     String? // ISO datetime; null em cortesia/ativo (RF-07, RF-17)
  aceiteTermosVersao String
  aceiteTermosEm     String
  /// Bloqueio pela administração (Fase 6.6): ninguém da empresa entra e o perfil sai do ar.
  /// O motivo é interno, nunca mostrado ao usuário.
  bloqueadaEm        String?
  bloqueioMotivo     String?
  /// Fase 6.5b: a administração conferiu os documentos da empresa (ou do profissional).
  verificadaEm       String?
  /// Fuso IANA em que os compromissos e lembretes da empresa são interpretados (ver src/lib/calendario/tempo.ts).
  fusoHorario        String       @default("America/Sao_Paulo")

  /// Código do link de convite da empresa (8 caracteres sem 0/O/1/I/L). Criado na primeira vez que o dono abre o link.
  codigoConvite  String?   @unique
  /// Empresa cujo link de convite originou este cadastro. Só rastreio: não dá acesso a nada da outra empresa.
  convidadaPorId String?
  convidadaPor   Empresa?  @relation("ConvitesDeCadastro", fields: [convidadaPorId], references: [id], onDelete: SetNull)
  convidadas     Empresa[] @relation("ConvitesDeCadastro")

  usuarios Usuario[]

  obras                         Obra[]
  contas                        ContaFinanceira[]
  fornecedores                  Fornecedor[]
  itensProduto                  ItemProduto[]
  funcionarios                  Funcionario[]
  categoriasPersonalizadas      CategoriaPersonalizada[]
  formasPagamentoPersonalizadas FormaPagamentoPersonalizada[]
  eventos                       EventoConta[]
  produtos                      Produto[]
  saldosEstoque                 SaldoEstoque[]
  movimentosEstoque             MovimentoEstoque[]
  perfilPublico                 PerfilPublico?
  avaliacoesFeitas              Avaliacao[]
  respostasAvaliacao            RespostaAvaliacao[]
  indicacoesFeitas              Indicacao[]
  notificacoes                  Notificacao[]
  denuncias                     Denuncia[]
  arquivos                      Arquivo[]
  solicitacoes                  SolicitacaoVerificacao[]
  compromissos                  Compromisso[]
  extensoesTeste                ExtensaoTeste[]
  emailsAgendados               EmailAgendado[]

  @@index([convidadaPorId])
}

/// Configuração da plataforma editável pelo administrador (uma linha por chave). Hoje só `ciclo_de_vida`: duração do
/// teste, limites de extensão e campanhas de e-mail. O formato é validado no código (src/lib/cicloDeVida/config.ts).
model ConfiguracaoPlataforma {
  chave           String  @id
  valor           Json
  atualizadoEm    String
  atualizadoPorId String?
}

/// Cada extensão do teste concedida pela administração. O fim original do teste é o `fimAnterior` da primeira linha.
model ExtensaoTeste {
  id             String  @id @default(uuid())
  empresaId      String
  empresa        Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  dias           Int
  motivo         String
  concedidaPorId String
  fimAnterior    String
  fimNovo        String
  criadoEm       String

  @@index([empresaId, criadoEm])
}

/// Evento de produto para as métricas. Sem relações de propósito: o histórico não some com a empresa e o evento não
/// carrega conteúdo (só ids e dados mínimos). `chave` única torna o registro idempotente (recarregar a página, rodar
/// o agendador duas vezes ou um webhook repetido não contam duas vezes).
model EventoProduto {
  id        String  @id @default(uuid())
  empresaId String?
  usuarioId String?
  tipo      String
  chave     String? @unique
  dados     Json?
  criadoEm  String

  @@index([tipo, criadoEm])
  @@index([empresaId, criadoEm])
}

/// Fila de e-mails de ciclo de vida (boas-vindas, dicas, fim do teste). `chave` única impede duplicar o mesmo e-mail;
/// o conteúdo é montado na hora do envio, depois de conferir de novo se ele ainda faz sentido.
model EmailAgendado {
  id                 String   @id @default(uuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId          String
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  campanha           String
  /// "transacional" (sobre a conta; ignora a preferência) ou "promocional" (dicas e ofertas; respeita o descadastro).
  categoria          String
  chave              String   @unique
  /// Fim do teste (ISO) ou id da extensão a que o e-mail se refere; se mudar antes do envio, o e-mail é cancelado.
  referencia         String?
  /// pendente | enviado | falhou | cancelado
  status             String   @default("pendente")
  tentativas         Int      @default(0)
  proximaTentativaEm String
  reservadoAte       String?
  enviadoEm          String?
  ultimoErro         String?
  criadoEm           String
  atualizadoEm       String

  @@index([status, proximaTentativaEm])
  @@index([usuarioId, categoria, enviadoEm])
  @@index([empresaId])
}

// Auditoria de mudanças de plano/teste (Fase 4) — hoje só extensão manual de
// teste (RF-18), via scripts/estender-teste.ts. Nunca grava e-mail, senha,
// token ou documento em claro em `detalhes` (só o necessário para a auditoria).
model EventoConta {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  tipo      String
  detalhes  Json
  criadoEm  String

  @@index([empresaId])
}

model Usuario {
  id                       String             @id @default(uuid())
  empresaId                String
  empresa                  Empresa            @relation(fields: [empresaId], references: [id])
  nome                     String
  /// Normalizado em minúsculas antes de gravar/comparar.
  email                    String             @unique
  senhaHash                String
  papel                    PapelDb            @default(dono)
  trocarSenha              Boolean            @default(false)
  falhasLogin              Int                @default(0)
  bloqueadoAte             String?
  /// Data da última falha de login (RF-10) — separado de atualizadoEm, que
  /// também muda em login OK e troca de senha e não serve como marca da janela.
  ultimaFalhaLoginEm       String?
  /// Administrador da plataforma (Fase 6) — independente de `papel`, que é por
  /// empresa. Só é concedido por script (admin:promover), nunca pela interface.
  papelPlataforma          PapelPlataformaDb?
  /// Quando o titular provou controlar este e-mail (link enviado a ele). Sem
  /// isso a conta usa a gestão, mas não publica nem interage na rede.
  emailConfirmadoEm        String?
  /// Bloqueio pela administração (Fase 6.6). Distinto de `bloqueadoAte`, que é a trava
  /// temporária por falhas de senha.
  bloqueadoPlataformaEm    String?
  bloqueioPlataformaMotivo String?
  /// Desativado pelo dono da empresa (usuário criado por ele). Distinto de `bloqueadoPlataformaEm`, que é a administração da plataforma.
  desativadoEm             String?
  /// Até quando a senha temporária (definida pelo dono ao criar ou redefinir) ainda entra. Só vale com `trocarSenha` ligado.
  senhaTemporariaExpiraEm  String?
  /// Preferências dos lembretes do calendário (Configurações). Ligadas por padrão.
  lembretesPorEmail        Boolean            @default(true)
  lembretesNoApp           Boolean            @default(true)
  /// Dicas e novidades por e-mail (campanhas educativas e promocionais). Os e-mails sobre a conta (confirmação, fim do teste) não dependem disto.
  emailsPromocionais       Boolean            @default(true)
  /// Vai no link de descadastro dos e-mails; só serve para desligar `emailsPromocionais`, nada mais.
  tokenDescadastro         String             @unique @default(dbgenerated("(gen_random_uuid())::text"))
  /// Módulos que o dono liberou (chaves de src/lib/auth/modulos.ts). Só vale para membros: o dono tem todos.
  modulos                  String[]           @default([])
  criadoEm                 String
  atualizadoEm             String

  sessoes             Sessao[]
  tokensEmail         TokenEmail[]
  emailsAgendados     EmailAgendado[]
  progressoOnboarding ProgressoOnboarding?

  compromissosCriados        Compromisso[]
  compromissosCompartilhados CompromissoParticipante[]
  entregasLembrete           EntregaLembrete[]
  notificacoes               Notificacao[]

  @@index([empresaId])
}

/// Token de uso único enviado por e-mail (hoje só a confirmação de endereço).
/// Só o sha256 fica no banco: quem lê um dump não consegue confirmar nada.
model TokenEmail {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  tokenHash String  @unique
  /// Endereço para o qual foi enviado; se o e-mail do usuário mudar, o token deixa de valer.
  email     String
  expiraEm  String
  usadoEm   String?
  criadoEm  String

  @@index([usuarioId, tipo])
}

model Sessao {
  id          String  @id // sha256(token) em hex — o token em si nunca é persistido
  usuarioId   String
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm    String
  criadoEm    String
  ultimoUsoEm String

  @@index([usuarioId])
}

// Rate limit de janela fixa (login, cadastro, IA). Chave composta em hash
// (ex.: sha256("login:" + email + ":" + ip)) — nunca e-mail/IP em claro.
model LimiteTaxa {
  chave        String @id
  janelaInicio String
  contagem     Int
}

// --- Estoque (ver docs/prd/estoque.md) -------------------------------------
// Fase 5.1: catálogo (Produto), saldo materializado por produto+obra
// (SaldoEstoque) e movimentação manual (MovimentoEstoque). `itemProdutoId`
// existe desde já porque MovimentoEstoque referencia ItemProduto, mas só é
// usado a partir da Fase 5.2 (integração com a captura por nota fiscal).

model Produto {
  id            String  @id @default(uuid())
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id])
  nome          String
  /// Único por empresa quando informado — múltiplos produtos sem SKU
  /// coexistem normalmente (Postgres não considera NULL == NULL num índice único).
  sku           String?
  categoria     String?
  unidade       String?
  /// Média ponderada pela quantidade, recalculada a cada entrada (RF-08 do PRD) — nunca em saída/ajuste.
  custoMedio    Float?
  estoqueMinimo Float?
  observacao    String?
  criadoEm      String
  atualizadoEm  String

  movimentos  MovimentoEstoque[]
  saldos      SaldoEstoque[]
  itensCompra ItemProduto[]

  @@unique([empresaId, sku])
  @@index([empresaId])
  @@index([nome])
}

// Saldo materializado por (produto, obra) — nunca somado a partir de
// MovimentoEstoque em runtime (ver mini-ADR do PRD). obraId é sempre
// obrigatório: um "estoque central" não alocado a uma obra específica usa
// uma Obra normal para representar isso, em vez de um obraId nulo (que
// quebraria a unicidade abaixo, já que Postgres trata NULL como distinto).
model SaldoEstoque {
  id           String  @id @default(uuid())
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  produtoId    String
  produto      Produto @relation(fields: [produtoId], references: [id])
  obraId       String
  obra         Obra    @relation(fields: [obraId], references: [id])
  quantidade   Float   @default(0)
  atualizadoEm String

  @@unique([produtoId, obraId])
  @@index([empresaId])
  @@index([obraId])
}

model MovimentoEstoque {
  id              String                 @id @default(uuid())
  empresaId       String
  empresa         Empresa                @relation(fields: [empresaId], references: [id])
  produtoId       String
  produto         Produto                @relation(fields: [produtoId], references: [id])
  obraId          String
  obra            Obra                   @relation(fields: [obraId], references: [id])
  tipo            TipoMovimentoEstoqueDb
  /// Sempre > 0 — o efeito no saldo (soma ou subtrai) depende de `tipo`, nunca do sinal.
  quantidade      Float
  valorUnitario   Float?
  /// "manual" | "item_produto" — rastreabilidade de onde a movimentação veio.
  origem          String
  itemProdutoId   String?
  itemProduto     ItemProduto?           @relation(fields: [itemProdutoId], references: [id])
  /// Nome do usuário da sessão que registrou (não FK — sobrevive se o usuário for removido no futuro), mesmo padrão de ContaFinanceira.historico[].usuario.
  lancadoPor      String
  observacao      String?
  criadoEm        String
  /// Liga a saída de um local e a entrada em outro na mesma transferência (origem "transferencia").
  transferenciaId String?

  @@index([empresaId])
  @@index([produtoId])
  @@index([obraId])
  @@index([transferenciaId])
}

// --- Rede profissional (Fase 6) --------------------------------------------
// PerfilPublico é separado de Empresa de propósito: empresas ainda sem cadastro
// poderão ter perfil (indicação, Fase 6.2) e depois reivindicá-lo. `empresaId`
// é opcional e único (1 empresa → no máximo 1 perfil).

enum TipoPerfilDb {
  pj
  pf
}

enum StatusPerfilDb {
  rascunho
  publicado
  /// Perfil básico criado por indicação de outra empresa, sem dono (empresaId nulo).
  indicado
  /// Escondido pela administração; o dono não consegue republicar.
  suspenso
}

model Categoria {
  id           String      @id @default(uuid())
  nome         String
  slug         String      @unique
  paiId        String?
  pai          Categoria?  @relation("CategoriaArvore", fields: [paiId], references: [id])
  filhas       Categoria[] @relation("CategoriaArvore")
  ordem        Int         @default(0)
  ativo        Boolean     @default(true)
  criadoEm     String
  atualizadoEm String

  profissoes Profissao[]

  @@index([paiId])
}

model Profissao {
  id           String    @id @default(uuid())
  nome         String
  slug         String    @unique
  categoriaId  String
  categoria    Categoria @relation(fields: [categoriaId], references: [id])
  ativo        Boolean   @default(true)
  criadoEm     String
  atualizadoEm String

  perfis PerfilProfissao[]

  @@index([categoriaId])
}

model PerfilPublico {
  id     String         @id @default(uuid())
  slug   String         @unique
  tipo   TipoPerfilDb
  status StatusPerfilDb @default(rascunho)

  nome         String
  nomeFantasia String?
  razaoSocial  String?
  descricao    String? @db.Text

  /// Texto normalizado (minúsculas, sem acento) só para busca — nunca exibido.
  nomeBusca   String
  cidadeBusca String?

  pais             String   @default("BR")
  estado           String?
  cidade           String?
  regiao           String?
  areasAtendimento String[] @default([])

  telefone        String?
  telefonePublico Boolean @default(false)
  whatsapp        String?
  whatsappPublico Boolean @default(false)
  instagram       String?
  site            String?

  empresaId String?  @unique
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  criadoEm     String
  atualizadoEm String

  /// CNPJ (só dígitos) informado por quem indicou uma empresa sem cadastro: serve
  /// para evitar perfis duplicados. Nunca é exibido.
  documentoIndicado    String? @unique
  /// Empresa que criou o perfil por indicação. Não pode avaliar o que criou.
  indicadoPorEmpresaId String?

  profissoes   PerfilProfissao[]
  avaliacoes   Avaliacao[]
  indicacoes   Indicacao[]
  denuncias    Denuncia[]
  arquivos     Arquivo[]
  servicos     Servico[]
  trabalhos    Trabalho[]
  solicitacoes SolicitacaoVerificacao[]

  @@index([status, estado, cidadeBusca])
  @@index([status, criadoEm])
}

model PerfilProfissao {
  perfilId    String
  perfil      PerfilPublico @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  profissaoId String
  profissao   Profissao     @relation(fields: [profissaoId], references: [id])

  @@id([perfilId, profissaoId])
  @@index([profissaoId])
}

/// Funcionalidades que um plano pode liberar (ex.: "rede", "gestao"). A
/// administração decide quais recursos cada plano tem via PlanoRecurso.
model Recurso {
  chave     String  @id
  nome      String
  descricao String?

  planos PlanoRecurso[]
}

/// `plano` é a chave do plano (valores de PlanoDb) em texto, e não o enum,
/// para permitir novos níveis de assinatura sem migration de enum.
model PlanoRecurso {
  plano        String
  recursoChave String
  recurso      Recurso @relation(fields: [recursoChave], references: [chave], onDelete: Cascade)

  @@id([plano, recursoChave])
}

/// Trilha de auditoria das ações da administração da plataforma.
model LogAdmin {
  id             String  @id @default(uuid())
  adminUsuarioId String
  acao           String
  alvoTipo       String
  alvoId         String?
  detalhes       Json
  criadoEm       String

  @@index([adminUsuarioId])
  @@index([alvoTipo, alvoId])
  @@index([criadoEm])
}

// --- Avaliações, indicações e notificações (Fase 6.2) -----------------------

enum StatusAvaliacaoDb {
  publicada
  /// Escondida pela moderação (Fase 6.3); some da página pública e das médias.
  oculta
  removida
}

enum StatusVerificacaoDb {
  nao_verificada
  relacao_confirmada
  relacao_comprovada
}

enum TipoVerificacaoDb {
  /// Selo "Empresa verificada" (ou "Profissional verificado" para autônomo).
  empresa_verificada
  /// A empresa diz que um perfil indicado é dela.
  reivindicacao_perfil
  /// O avaliador comprova por documento que contratou o avaliado.
  relacao_comprovada
}

enum StatusSolicitacaoDb {
  pendente
  aprovada
  recusada
  cancelada
  expirada
  /// Aprovada e depois desfeita pela administração (selo revogado, perfil devolvido, relação rebaixada).
  revogada
}

/// Pedido de verificação analisado por uma pessoa da administração. Nada é vinculado
/// nem verificado sem decisão humana. Os documentos (Arquivo, finalidade "documento")
/// são apagados quando o pedido sai de "pendente"; fica só esta decisão.
model SolicitacaoVerificacao {
  id                   String              @id @default(uuid())
  tipo                 TipoVerificacaoDb
  status               StatusSolicitacaoDb @default(pendente)
  solicitanteEmpresaId String
  solicitanteEmpresa   Empresa             @relation(fields: [solicitanteEmpresaId], references: [id], onDelete: Cascade)
  solicitanteUsuarioId String
  /// Só em reivindicacao_perfil.
  perfilId             String?
  perfil               PerfilPublico?      @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  /// Só em relacao_comprovada.
  avaliacaoId          String?
  avaliacao            Avaliacao?          @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  /// O que o solicitante quis dizer à administração.
  observacao           String?             @db.Text
  decididaPorUsuarioId String?
  decididaEm           String?
  /// Motivo da decisão (obrigatório na recusa); o solicitante o vê.
  motivoDecisao        String?             @db.Text
  criadoEm             String
  atualizadoEm         String

  documentos Arquivo[]

  @@index([status, criadoEm])
  @@index([solicitanteEmpresaId, status])
  @@index([perfilId])
  @@index([avaliacaoId])
}

enum EstadoRelacaoDb {
  confirmada
  contestada
}

/// Resposta do avaliado à pergunta "você trabalhou com esta empresa?". Registra
/// quem respondeu, quando e por qual método (hoje só "confirmacao_avaliado";
/// a comprovação por documento entra na Fase 6.5b). Uma por avaliação.
model VerificacaoRelacao {
  id                     String          @id @default(uuid())
  avaliacaoId            String          @unique
  avaliacao              Avaliacao       @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estado                 EstadoRelacaoDb
  metodo                 String
  respondidaPorUsuarioId String
  respondidaEm           String

  @@index([estado, respondidaEm])
}

/// Cada resposta do avaliado sobre a relação, em ordem, nunca sobrescrita:
/// o estado atual fica em VerificacaoRelacao, a trilha (quem, quando, o quê) aqui.
model VerificacaoRelacaoHistorico {
  id           String          @id @default(uuid())
  avaliacaoId  String
  avaliacao    Avaliacao       @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estado       EstadoRelacaoDb
  metodo       String
  usuarioId    String
  registradoEm String

  @@index([avaliacaoId, registradoEm])
}

/// Uma avaliação por par (empresa avaliadora, perfil avaliado).
model Avaliacao {
  id                 String              @id @default(uuid())
  perfilId           String
  perfil             PerfilPublico       @relation(fields: [perfilId], references: [id])
  avaliadorEmpresaId String
  avaliador          Empresa             @relation(fields: [avaliadorEmpresaId], references: [id])
  avaliadorUsuarioId String
  nota               Int
  comentario         String?             @db.Text
  /// Chaves da lista fechada de aspectos (src/lib/rede/aspectos.ts).
  pros               String[]            @default([])
  contras            String[]            @default([])
  status             StatusAvaliacaoDb   @default(publicada)
  statusVerificacao  StatusVerificacaoDb @default(nao_verificada)
  versao             Int                 @default(1)
  criadoEm           String
  atualizadoEm       String
  editadaEm          String?

  resposta                     RespostaAvaliacao?
  historico                    AvaliacaoHistorico[]
  denuncias                    Denuncia[]
  verificacaoRelacao           VerificacaoRelacao?
  verificacoesRelacaoHistorico VerificacaoRelacaoHistorico[]
  solicitacoes                 SolicitacaoVerificacao[]

  @@unique([avaliadorEmpresaId, perfilId])
  @@index([perfilId, status, criadoEm])
  @@index([status, perfilId])
  @@index([avaliadorEmpresaId])
}

/// Versão anterior de uma avaliação, gravada a cada edição (auditoria).
model AvaliacaoHistorico {
  id                     String    @id @default(uuid())
  avaliacaoId            String
  avaliacao              Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  versao                 Int
  nota                   Int
  comentario             String?   @db.Text
  pros                   String[]  @default([])
  contras                String[]  @default([])
  registradoPorUsuarioId String
  registradoEm           String

  @@unique([avaliacaoId, versao])
}

/// Direito de resposta do avaliado. Uma por avaliação; não apaga a avaliação.
model RespostaAvaliacao {
  id             String    @id @default(uuid())
  avaliacaoId    String    @unique
  avaliacao      Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  autorEmpresaId String
  autorEmpresa   Empresa   @relation(fields: [autorEmpresaId], references: [id])
  autorUsuarioId String
  texto          String    @db.Text
  criadoEm       String
  atualizadoEm   String
}

/// Recomendação de um perfil por uma empresa (uma por par).
model Indicacao {
  id                   String        @id @default(uuid())
  perfilId             String
  perfil               PerfilPublico @relation(fields: [perfilId], references: [id])
  indicadoPorEmpresaId String
  indicadoPor          Empresa       @relation(fields: [indicadoPorEmpresaId], references: [id], onDelete: Cascade)
  criadoEm             String

  @@unique([indicadoPorEmpresaId, perfilId])
  @@index([perfilId])
}

model Notificacao {
  id            String       @id @default(uuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Destinatário individual (lembretes do calendário). Nulo = notificação da empresa, visível a todos os usuários dela.
  usuarioId     String?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Compromisso de origem; a notificação sobrevive à exclusão dele (o vínculo vira nulo).
  compromissoId String?
  compromisso   Compromisso? @relation(fields: [compromissoId], references: [id], onDelete: SetNull)
  tipo          String
  titulo        String?
  texto         String
  /// Caminho interno para onde a notificação leva.
  href          String
  lida          Boolean      @default(false)
  criadoEm      String

  @@index([empresaId, lida, criadoEm])
  @@index([usuarioId, lida, criadoEm])
  @@index([compromissoId])
}

// --- Denúncias e moderação (Fase 6.3) ---------------------------------------

enum TipoDenunciaDb {
  fraude
  avaliacao_falsa
  nunca_trabalhou
  conteudo_ofensivo
  spam
  informacao_falsa
  conflito_interesse
  outro
}

enum StatusDenunciaDb {
  aberta
  em_analise
  aguardando_informacoes
  resolvida
  rejeitada
}

enum DecisaoDenunciaDb {
  mantida
  avaliacao_ocultada
  avaliacao_removida
  perfil_suspenso
}

/// Denúncia de uma avaliação ou de um perfil (exatamente um dos dois alvos,
/// garantido por CHECK na migration). Nunca remove nada sozinha: só a
/// decisão de um administrador altera o conteúdo.
model Denuncia {
  id                    String             @id @default(uuid())
  denuncianteEmpresaId  String
  denunciante           Empresa            @relation(fields: [denuncianteEmpresaId], references: [id], onDelete: Cascade)
  denuncianteUsuarioId  String
  avaliacaoId           String?
  avaliacao             Avaliacao?         @relation(fields: [avaliacaoId], references: [id], onDelete: Restrict)
  perfilId              String?
  perfil                PerfilPublico?     @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  motivo                TipoDenunciaDb
  descricao             String             @db.Text
  /// Informação adicional enviada pelo denunciante quando a administração pediu.
  complemento           String?            @db.Text
  status                StatusDenunciaDb   @default(aberta)
  adminResponsavelId    String?
  decisao               DecisaoDenunciaDb?
  /// Anotação interna da administração (nunca exibida ao denunciante).
  observacaoAdmin       String?            @db.Text
  /// Mensagem que o denunciante vê (pedido de informação ou resultado).
  mensagemAoDenunciante String?            @db.Text
  criadoEm              String
  atualizadoEm          String
  resolvidaEm           String?

  @@unique([denuncianteEmpresaId, avaliacaoId])
  @@unique([denuncianteEmpresaId, perfilId])
  @@index([status, criadoEm])
  @@index([avaliacaoId])
  @@index([perfilId])
}

// --- Portfólio, serviços e arquivos (Fase 6.4) ------------------------------

enum FinalidadeArquivoDb {
  logo
  portfolio
  /// Documentos de comprovação (Fase 6.5b): privados e cifrados, nunca servidos em rota pública.
  documento
}

/// Arquivo guardado no próprio Postgres (sem storage externo ainda). Todo acesso
/// passa pelo módulo de armazenamento, para trocar por Blob/S3 sem mexer no resto.
model Arquivo {
  id            String                  @id @default(uuid())
  empresaId     String
  empresa       Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  perfilId      String?
  perfil        PerfilPublico?          @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  finalidade    FinalidadeArquivoDb
  mime          String
  /// Tamanho do arquivo original (em documentos cifrados, `dados` é maior: iv + tag + conteúdo).
  tamanho       Int
  dados         Bytes
  /// Documentos de verificação são sempre cifrados no app (AES-256-GCM); ver CHECK na migration.
  cifrado       Boolean                 @default(false)
  /// Quando os bytes foram apagados (decisão, cancelamento ou prazo): `dados` fica vazio.
  apagadoEm     String?
  solicitacaoId String?
  solicitacao   SolicitacaoVerificacao? @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  /// SHA-256 do conteúdo claro de um documento de verificação: prova do que foi analisado depois que os bytes são apagados.
  sha256        String?
  criadoEm      String

  foto TrabalhoFoto?

  @@index([perfilId, finalidade])
  @@index([empresaId])
  @@index([solicitacaoId])
}

model Servico {
  id        String        @id @default(uuid())
  perfilId  String
  perfil    PerfilPublico @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  ordem     Int           @default(0)
  criadoEm  String

  trabalhos Trabalho[]

  @@index([perfilId, ordem])
}

/// Um trabalho realizado, com fotos. `galeria` agrupa trabalhos no perfil público.
model Trabalho {
  id           String        @id @default(uuid())
  perfilId     String
  perfil       PerfilPublico @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  titulo       String
  descricao    String?       @db.Text
  servicoId    String?
  servico      Servico?      @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  galeria      String?
  /// Data opcional do trabalho (aaaa-mm-dd).
  dataTrabalho String?
  ordem        Int           @default(0)
  criadoEm     String
  atualizadoEm String

  fotos TrabalhoFoto[]

  @@index([perfilId, ordem])
}

model TrabalhoFoto {
  id         String   @id @default(uuid())
  trabalhoId String
  trabalho   Trabalho @relation(fields: [trabalhoId], references: [id], onDelete: Cascade)
  arquivoId  String   @unique
  arquivo    Arquivo  @relation(fields: [arquivoId], references: [id], onDelete: Cascade)
  ordem      Int      @default(0)
  criadoEm   String

  @@index([trabalhoId, ordem])
}

// --- Localização (Fase 6.7) -------------------------------------------------

/// Municípios do Brasil com o ponto central (latitude/longitude): base da busca por raio.
/// Dado público, importado por `yarn seed:municipios` de prisma/dados/municipios.csv
/// (kelvins/Municipios-Brasileiros, MIT, derivado do IBGE). O perfil não aponta para cá por FK:
/// a ligação é por (estado, cidadeBusca), então a cidade digitada continua livre e nada quebra
/// se a tabela estiver vazia.
model Municipio {
  ibgeId    Int    @id
  nome      String
  /// Minúsculo e sem acento; mesma normalização de PerfilPublico.cidadeBusca.
  nomeBusca String
  uf        String
  latitude  Float
  longitude Float

  @@unique([uf, nomeBusca])
}

// --- Calendário e lembretes ---------------------------------------------------
// Data, hora e fuso ficam como o usuário digitou (data/horaInicio/horaFim locais + fuso IANA); inicioEm e
// fimEm são os instantes em UTC derivados deles, usados para agendar lembretes e para saber se já passou.
// Compromisso de dia inteiro: inicioEm é a meia-noite local e fimEm o último instante do dia local.

enum CategoriaCompromissoDb {
  reuniao
  visita
  prazo
  financeiro
  pessoal
  outro
}

enum StatusCompromissoDb {
  agendado
  concluido
  cancelado
}

model Compromisso {
  id           String                 @id @default(uuid())
  empresaId    String
  empresa      Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Responsável: único que edita, exclui e compartilha.
  criadoPorId  String
  criadoPor    Usuario                @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)
  titulo       String
  descricao    String?                @db.Text
  categoria    CategoriaCompromissoDb @default(outro)
  status       StatusCompromissoDb    @default(agendado)
  /// "AAAA-MM-DD" no fuso do compromisso.
  data         String
  diaInteiro   Boolean                @default(false)
  /// "HH:mm" locais; nulos em dia inteiro.
  horaInicio   String?
  horaFim      String?
  fuso         String
  inicioEm     String
  fimEm        String
  criadoEm     String
  atualizadoEm String

  participantes CompromissoParticipante[]
  lembretes     LembreteCompromisso[]
  notificacoes  Notificacao[]

  @@index([empresaId, data])
  @@index([criadoPorId, data])
}

/// Quem recebe o compromisso no próprio calendário, além do criador. Sair daqui tira o acesso.
model CompromissoParticipante {
  compromissoId String
  compromisso   Compromisso @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm      String

  @@id([compromissoId, usuarioId])
  @@index([usuarioId])
}

enum TipoLembreteDb {
  vespera
  dia
}

enum StatusLembreteDb {
  pendente
  /// Reservado por um processamento em andamento (expira em travadoAte, para sobreviver a queda).
  processando
  /// Entregas criadas para os destinatários; o resto é com EntregaLembrete.
  processado
  /// Não será enviado (compromisso cancelado, concluído, já passado ou horário do lembrete no passado).
  ignorado
}

/// No máximo um lembrete de cada tipo por compromisso (unicidade = agendamento idempotente).
model LembreteCompromisso {
  id            String           @id @default(uuid())
  compromissoId String
  compromisso   Compromisso      @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  tipo          TipoLembreteDb
  /// Instante UTC do disparo.
  disparoEm     String
  /// Sobe a cada reagendamento: uma entrega é única por (lembrete, versão, usuário, canal), então remarcar
  /// o compromisso permite avisar de novo sem abrir brecha para duplicar no reprocessamento.
  versao        Int              @default(1)
  status        StatusLembreteDb @default(pendente)
  travadoAte    String?
  processadoEm  String?
  criadoEm      String
  atualizadoEm  String

  entregas EntregaLembrete[]

  @@unique([compromissoId, tipo])
  @@index([status, disparoEm])
}

enum CanalLembreteDb {
  email
  app
}

enum StatusEntregaDb {
  pendente
  enviada
  /// Esgotou as tentativas.
  falhou
  /// Deixou de fazer sentido (compromisso cancelado, concluído ou já encerrado).
  ignorada
}

/// Estado e histórico de cada envio: um por destinatário e canal.
model EntregaLembrete {
  id                 String              @id @default(uuid())
  lembreteId         String
  lembrete           LembreteCompromisso @relation(fields: [lembreteId], references: [id], onDelete: Cascade)
  versao             Int
  usuarioId          String
  usuario            Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  canal              CanalLembreteDb
  status             StatusEntregaDb     @default(pendente)
  tentativas         Int                 @default(0)
  proximaTentativaEm String?
  travadoAte         String?
  /// Motivo curto da última falha; nunca e-mail, token ou corpo da mensagem.
  ultimoErro         String?
  enviadoEm          String?
  criadoEm           String
  atualizadoEm       String

  @@unique([lembreteId, versao, usuarioId, canal])
  @@index([status, proximaTentativaEm])
}

/// Parte do valor de uma conta que pertence a um destino (projeto ou Depósito). Só existe para nota fiscal com itens
/// em mais de um destino ou com destino diferente do projeto da conta; a soma dos rateios é o valor da conta.
model RateioConta {
  id                String          @id @default(uuid())
  contaFinanceiraId String
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  obraId            String
  obra              Obra            @relation(fields: [obraId], references: [id])
  valor             Float

  @@unique([contaFinanceiraId, obraId])
  @@index([obraId])
}

/// Progresso do onboarding de cada usuário: estado do tour, checklist oculto e tutoriais já vistos. O que está feito no
/// checklist NÃO é guardado aqui: sai dos dados reais (projeto criado, conta lançada...), para ninguém "marcar" sem fazer.
model ProgressoOnboarding {
  usuarioId         String   @id
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// nao_iniciado | em_andamento | concluido | pulado
  tourEstado        String   @default("nao_iniciado")
  /// Passo em que a pessoa parou (para retomar de onde saiu).
  tourPasso         Int      @default(0)
  checklistOcultoEm String?
  /// Chaves dos tutoriais ("Como funciona?") já abertos. Pode repetir por corrida; quem lê remove as repetições.
  ajudasVistas      String[] @default([])
  criadoEm          String
  atualizadoEm      String
}

/// Catálogo comercial de planos (nome, preço, benefícios) para a página de planos e as ofertas. É só vitrine: não
/// concede acesso nem cobra (os recursos de cada plano vêm de PlanoRecurso). Preços em centavos; sem preço, o plano
/// aparece como "sob consulta". Nenhum plano existe até o administrador cadastrar e publicar.
model PlanoComercial {
  id                   String   @id @default(uuid())
  chave                String   @unique
  nome                 String
  descricao            String
  precoMensalCentavos  Int?
  precoAnualCentavos   Int?
  beneficios           String[] @default([])
  destaque             Boolean  @default(false)
  publicado            Boolean  @default(false)
  ordem                Int      @default(0)
  criadoEm             String
  atualizadoEm         String
}
